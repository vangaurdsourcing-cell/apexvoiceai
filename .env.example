# Apex AI Platform Configuration

# Brand
BRAND_NAME=Apex AI

# Sarvam AI (for TTS/STT)
SARVAM_API_KEY=your_sarvam_api_key_here

# OpenAI (optional, for smarter summaries)
OPENAI_API_KEY=your_openai_api_key_here

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token

# Exotel (optional, for real phone calls)
EXOTEL_SID=your_exotel_sid
EXOTEL_TOKEN=your_exotel_token
EXOTEL_CALLER_ID=your_caller_id

# Webhook Security (optional)
SARVAM_WEBHOOK_SECRET=your_webhook_secret_here
